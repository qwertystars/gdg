# GDG Remote Runtime environment variables.
# Copy to .env and fill in secrets; constants mirror wrangler.jsonc "vars".

# Source size cap in bytes (architecture section 44).
SOURCE_LIMIT_BYTES=131072
# Default per-problem wall-clock limit in milliseconds.
DEFAULT_TIME_LIMIT_MS=2000
# Default per-problem memory limit in kilobytes.
DEFAULT_MEMORY_LIMIT_KB=262144
# Default per-problem output limit in bytes.
DEFAULT_OUTPUT_LIMIT_BYTES=1048576
# Judge execution window in milliseconds; must exceed a normal judging attempt.
LEASE_DURATION_MS=600000
# Maximum infrastructure retries before JUDGE_ERROR / DLQ.
MAX_JUDGE_RETRIES=3
# Participant-visible compiler output cap in bytes.
COMPILER_OUTPUT_LIMIT_BYTES=65536
# Rate limit: max submissions per participant per window.
RATE_LIMIT_SUBMISSIONS=5
# Rate limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=10000

# Cloudflare account ID (set with `wrangler secret put` in production).
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token with Containers/R2/Queue permissions.
CLOUDFLARE_API_TOKEN=
# Secret used to sign judge lease/result payloads between the API and judge workers.
JUDGE_SIGNING_SECRET=
